# Copy to .env locally. Never commit real values.

SORFTIME_API_KEY=
SORFTIME_DOMAIN=1
SORFTIME_TIMEOUT=120

DORIS_HOST=doris.example.invalid
DORIS_MYSQL_PORT=30930
DORIS_STREAM_LOAD_HOST=doris-stream-load.example.invalid
DORIS_STREAM_LOAD_PORT=33060
DORIS_STREAM_LOAD_FALLBACK_HOST=
DORIS_STREAM_LOAD_FALLBACK_PORT=
DORIS_USER=
DORIS_PASSWORD=
DORIS_DATABASE=
DORIS_TABLE=

# Taotian uses a separate namespace so its Doris tables/credentials cannot
# accidentally overwrite the Amazon connection above.
TAOTIAN_DORIS_HOST=doris.example.invalid
TAOTIAN_DORIS_PORT=30930
TAOTIAN_DORIS_USER=
TAOTIAN_DORIS_PASSWORD=
TAOTIAN_DORIS_DATABASE=
TAOTIAN_DORIS_SOURCE_TABLE=
TAOTIAN_DORIS_TARGET_TABLE=
TAOTIAN_DORIS_STREAM_LOAD_HOSTS=doris-stream-load.example.invalid
TAOTIAN_DORIS_STREAM_LOAD_PORTS=33060
TAOTIAN_DORIS_STREAM_LOAD_FALLBACK_HOST=
TAOTIAN_DORIS_STREAM_LOAD_FALLBACK_PORT=0
TAOTIAN_DORIS_STREAM_LOAD_UNCERTAIN_WAIT_SECONDS=20

MAX_WORKERS=4
TARGET_WEEKDAY=wednesday
DASHBOARD_KEEP_WEEKS=12
DASHBOARD_PUBLIC_URL=
DASHBOARD_DATA_MODE=0644

# Optional server-local overrides used by the cron wrapper.
DASHBOARD_PROJECT_ROOT=/opt/ulanzi/report/Amazon-BSR-dashboard
DASHBOARD_WEEKLY_LOCK_FILE=/tmp/amazon-bsr-dashboard.lock
DASHBOARD_PYTHON_BIN=/opt/ulanzi/report/Amazon-BSR-dashboard/.venv/bin/python3
